# Advanced/manual configuration example.
# Normally use: xkeen-autoreload-vless setup

XKEEN_SUBSCRIPTION_URL=https://example.com/subscription
XKEEN_COUNTRY=Швейцария
XKEEN_CITY=
XKEEN_OUTBOUND_PATH=/opt/etc/xray/configs/04_outbounds.json
XKEEN_STATE_PATH=/opt/var/lib/xkeen-autoreload-vless/state.json
XKEEN_COMMAND=xkeen
XKEEN_INTERVAL=1h
XKEEN_HTTP_TIMEOUT=20s
